[
  {
    "name": "On Browser Home Page",
    "description": "Start the Process",
    "checks": [
      {
        "type": "url",
        "params": {
          "url": "chrome://new-tab-page/"
        }
      }
    ],
    "actions": [
      {
        "type": "navigate",
        "params": {
          "url": "https://www.youtube.com/channel/UC4R8DWoMoI7CAwX8_LjQHig"
        }
      },
      {
        "type": "terminate",
        "params": {
          "reason": "The YouTube video has loaded successfully. As per the instructions, the next step is to terminate the task."
        }
      }
    ],
    "end_state": "",
    "executed": []
  },
  {
    "name": "On the Video Player",
    "description": "Play the video from the beginning for 30 seconds",
    "checks": [
      {
        "type": "url",
        "params": {
          "url": "https://www.youtube.com/channel/UC4R8DWoMoI7CAwX8_LjQHig"
        }
      }
    ],
    "actions": [
    {
        "type": "click",
        "params":{
            "x": 1000,
            "y": 500
        }
    },
      {
        "type": "start_stats_logging",
        "params": {
          "out_path": "/capture/stats/youtube_stats.jsonl",
          "interval": 2.0
        }
      },
      {
        "type": "wait",
        "params": {
          "seconds": 180
        }
      },
      {
        "type": "stop_stats_logging",
        "params":{}

      },
      {
        "type": "terminate",
        "params": {
          "reason": "The video has been played from the beginning and the 600-second wait is complete. Terminating the task as per instructions."
        }
      }
    ],
    "end_state": "Action Completed",
    "executed": []
  }
]
